generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Novel {
  id           Int           @id @default(autoincrement())
  title        String
  content      String
  author       String
  uploadTime   DateTime      @default(now())
  parseStatus  String        @default("UNPARSED")
  remark       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  characters   Character[]
  messages     ChatMessage[]
  sessions     ChatSession[]
  memories     Memory[]
  plots        Plot[]
  plotPredicts PlotPredict[]
  scenes       Scene[]
  townEvents   TownEvent[]
  townStatus   TownStatus?
}

model Character {
  id            Int      @id @default(autoincrement())
  novelId       Int
  name          String
  avatarUrl     String?
  description   String
  plotSetting   String
  relationships String
  /// This field was commented out because of an invalid name. Please provide a valid one that matches [a-zA-Z][a-zA-Z0-9_]*
  // 出场情节 String
  coreIdentity  String?
  classicLines  String?
  currentScene  String   @default("小镇广场")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  imagePrompt   String?
  imageUrl      String?
  novel         Novel    @relation(fields: [novelId], references: [id])
  memories      Memory[]
}

model Memory {
  id               Int       @id @default(autoincrement())
  characterId      Int
  novelId          Int
  content          String
  timestamp        DateTime
  type             String
  importance       Int       @default(5)
  tags             String    @default("[]")
  isArchived       Boolean   @default(false)
  isCompressed     Boolean   @default(false)
  compressedFrom   String?
  version          Int       @default(1)
  expiresAt        DateTime?
  embedding        String?
  keywords         String    @default("[]")
  entities         String    @default("[]")
  sentiment        String?
  source           String    @default("auto")
  relatedMemoryIds String    @default("[]")
  // 访问频率统计字段
  accessCount      Int       @default(0)
  lastAccessedAt   DateTime?
  // 用户自定义重要性字段
  isManuallySet    Boolean   @default(false)
  manualSetBy      String?
  manualSetAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  novel            Novel     @relation(fields: [novelId], references: [id])
  character        Character @relation(fields: [characterId], references: [id])
  importanceHistory MemoryImportanceHistory[]
}

model MemorySummary {
  id             Int       @id @default(autoincrement())
  characterId    Int
  novelId        Int
  memoryType     String
  content        String
  dateRangeStart DateTime?
  dateRangeEnd   DateTime?
  keywords       String    @default("[]")
  memoryCount    Int       @default(0)
  importance     Int       @default(5)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Reflection {
  id              Int      @id @default(autoincrement())
  characterId     Int
  novelId         Int
  content         String
  triggerEvent    String?
  relatedMemories String   @default("[]")
  importance      Int      @default(8)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Observation {
  id           Int      @id @default(autoincrement())
  characterId  Int
  novelId      Int
  content      String
  sourceType   String
  sourceId     Int?
  sourceName   String?
  location     String?
  participants String   @default("[]")
  emotion      String?
  isImportant  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatSession {
  id              Int           @id @default(autoincrement())
  type            String
  name            String        @default("聊天")
  novelId         Int
  sceneId         Int?
  participantIds  String        @default("[]")
  createdAt       DateTime      @default(now())
  lastMessageTime DateTime
  status          String        @default("STOPPED")
  updatedAt       DateTime      @updatedAt
  messages        ChatMessage[]
  novel           Novel         @relation(fields: [novelId], references: [id])
}

model ChatMessage {
  id         Int          @id @default(autoincrement())
  novelId    Int
  senderType String
  senderId   Int
  receiverId Int
  content    String
  sendTime   DateTime
  isRead     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  sessionId  Int?
  session    ChatSession? @relation(fields: [sessionId], references: [id])
  novel      Novel        @relation(fields: [novelId], references: [id])
}

model PlotPredict {
  id               Int      @id @default(autoincrement())
  novelId          Int
  content          String
  predictTime      DateTime
  triggerCondition String
  isSynced         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  novel            Novel    @relation(fields: [novelId], references: [id])
}

model Plot {
  id                   Int       @id @default(autoincrement())
  novelId              Int
  chapterIndex         Int       @default(0)
  sceneIndex           Int       @default(0)
  title                String
  content              String
  involvedCharacterIds String    @default("[]")
  dialogueContent      String    @default("[]")
  narrationContent     String    @default("")
  location             String    @default("")
  isCompleted          Boolean   @default(false)
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  novel                Novel     @relation(fields: [novelId], references: [id])
}

model Scene {
  id          Int      @id @default(autoincrement())
  novelId     Int
  name        String
  description String?
  type        String
  positionX   Int      @default(0)
  positionY   Int      @default(0)
  characters  String   @default("[]")
  isActive    Boolean  @default(true)
  imageUrl    String?
  imagePrompt String?
  mapStyle    String   @default("building")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  novel       Novel    @relation(fields: [novelId], references: [id])
}

model TownEvent {
  id            Int      @id @default(autoincrement())
  novelId       Int
  sceneId       Int?
  characterId   Int?
  type          String
  content       String
  timestamp     DateTime @default(now())
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  characterName String?
  novel         Novel    @relation(fields: [novelId], references: [id])
}

model TownStatus {
  id             Int      @id @default(autoincrement())
  novelId        Int      @unique
  isRunning      Boolean  @default(false)
  speed          Int      @default(1)
  currentTime    DateTime @default(now())
  lastUpdateTime DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  novel          Novel    @relation(fields: [novelId], references: [id])
}

// 记忆重要性修改历史模型
model MemoryImportanceHistory {
  id            Int      @id @default(autoincrement())
  memoryId      Int
  oldImportance Int
  newImportance Int
  operator      String
  operatorType  String   @default("user")
  reason        String?
  createdAt     DateTime @default(now())
  memory        Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([createdAt])
}
