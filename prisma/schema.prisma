generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Novel {
  id           Int           @id @default(autoincrement())
  title        String
  content      String
  author       String
  uploadTime   DateTime      @default(now())
  parseStatus  String        @default("UNPARSED")
  remark       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  characters   Character[]
  messages     ChatMessage[]
  sessions     ChatSession[]
  memories     Memory[]
  plots        Plot[]
  plotPredicts PlotPredict[]
  scenes       Scene[]
  townEvents   TownEvent[]
  townStatus   TownStatus?
  prophecies   Prophecy[]
  // 新增：小镇地图系统关联
  townMap      TownMap?
  movements    Movement[]
}

model Character {
  id            Int      @id @default(autoincrement())
  novelId       Int
  name          String
  avatarUrl     String?
  description   String
  plotSetting   String
  relationships String
  /// This field was commented out because of an invalid name. Please provide a valid one that matches [a-zA-Z][a-zA-Z0-9_]*
  // 出场情节 String
  coreIdentity  String?
  classicLines  String?
  currentScene  String   @default("小镇广场")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  imagePrompt   String?
  imageUrl      String?
  novel         Novel    @relation(fields: [novelId], references: [id])
  memories      Memory[]
  // 新增：小镇地图系统关联
  position      CharacterPosition?
  movements     Movement[]
}

model Memory {
  id               Int       @id @default(autoincrement())
  characterId      Int
  novelId          Int
  content          String
  timestamp        DateTime
  type             String
  importance       Int       @default(5)
  tags             String    @default("[]")
  isArchived       Boolean   @default(false)
  isCompressed     Boolean   @default(false)
  compressedFrom   String?
  version          Int       @default(1)
  expiresAt        DateTime?
  embedding        String?
  keywords         String    @default("[]")
  entities         String    @default("[]")
  sentiment        String?
  source           String    @default("auto")
  relatedMemoryIds String    @default("[]")
  // 访问频率统计字段
  accessCount      Int       @default(0)
  lastAccessedAt   DateTime?
  // 用户自定义重要性字段
  isManuallySet    Boolean   @default(false)
  manualSetBy      String?
  manualSetAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  novel            Novel     @relation(fields: [novelId], references: [id])
  character        Character @relation(fields: [characterId], references: [id])
  importanceHistory MemoryImportanceHistory[]
}

model MemorySummary {
  id             Int       @id @default(autoincrement())
  characterId    Int
  novelId        Int
  memoryType     String
  content        String
  dateRangeStart DateTime?
  dateRangeEnd   DateTime?
  keywords       String    @default("[]")
  memoryCount    Int       @default(0)
  importance     Int       @default(5)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Reflection {
  id              Int      @id @default(autoincrement())
  characterId     Int
  novelId         Int
  content         String
  triggerEvent    String?
  relatedMemories String   @default("[]")
  importance      Int      @default(8)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Observation {
  id           Int      @id @default(autoincrement())
  characterId  Int
  novelId      Int
  content      String
  sourceType   String
  sourceId     Int?
  sourceName   String?
  location     String?
  participants String   @default("[]")
  emotion      String?
  isImportant  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatSession {
  id              Int           @id @default(autoincrement())
  type            String
  name            String        @default("聊天")
  novelId         Int
  sceneId         Int?
  participantIds  String        @default("[]")
  createdAt       DateTime      @default(now())
  lastMessageTime DateTime
  status          String        @default("STOPPED")
  updatedAt       DateTime      @updatedAt
  messages        ChatMessage[]
  novel           Novel         @relation(fields: [novelId], references: [id])
}

model ChatMessage {
  id         Int          @id @default(autoincrement())
  novelId    Int
  senderType String
  senderId   Int
  receiverId Int
  content    String
  sendTime   DateTime
  isRead     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  sessionId  Int?
  session    ChatSession? @relation(fields: [sessionId], references: [id])
  novel      Novel        @relation(fields: [novelId], references: [id])
}

model PlotPredict {
  id               Int      @id @default(autoincrement())
  novelId          Int
  content          String
  predictTime      DateTime
  triggerCondition String
  isSynced         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  novel            Novel    @relation(fields: [novelId], references: [id])
}

model Plot {
  id                   Int       @id @default(autoincrement())
  novelId              Int
  chapterIndex         Int       @default(0)
  sceneIndex           Int       @default(0)
  title                String
  content              String
  involvedCharacterIds String    @default("[]")
  dialogueContent      String    @default("[]")
  narrationContent     String    @default("")
  location             String    @default("")
  isCompleted          Boolean   @default(false)
  completedAt          DateTime?
  // 情节来源：original(原小说), prophecy(预言), modified(修改)
  source               String    @default("original")
  // 如果是预言情节，关联的预言ID
  prophecyId           Int?
  // 如果是修改的情节，关联的原情节ID
  parentPlotId         Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  novel                Novel     @relation(fields: [novelId], references: [id])
  interventions        PlotIntervention[]

  @@index([novelId])
  @@index([source])
  @@index([prophecyId])
}

model Scene {
  id          Int      @id @default(autoincrement())
  novelId     Int
  name        String
  description String?
  type        String
  positionX   Int      @default(0)
  positionY   Int      @default(0)
  characters  String   @default("[]")
  isActive    Boolean  @default(true)
  imageUrl    String?
  imagePrompt String?
  mapStyle    String   @default("building")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  novel       Novel    @relation(fields: [novelId], references: [id])
}

model TownEvent {
  id            Int      @id @default(autoincrement())
  novelId       Int
  sceneId       Int?
  characterId   Int?
  type          String
  content       String
  timestamp     DateTime @default(now())
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  characterName String?
  novel         Novel    @relation(fields: [novelId], references: [id])
}

model TownStatus {
  id             Int      @id @default(autoincrement())
  novelId        Int      @unique
  isRunning      Boolean  @default(false)
  speed          Int      @default(1)
  currentTime    DateTime @default(now())
  lastUpdateTime DateTime @default(now())
  // 模拟进度保存
  currentPlotIndex     Int      @default(0)
  currentDialogueIndex Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  novel          Novel    @relation(fields: [novelId], references: [id])
}

// 记忆重要性修改历史模型
model MemoryImportanceHistory {
  id            Int      @id @default(autoincrement())
  memoryId      Int
  oldImportance Int
  newImportance Int
  operator      String
  operatorType  String   @default("user")
  reason        String?
  createdAt     DateTime @default(now())
  memory        Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([createdAt])
}

// 预言模型
model Prophecy {
  id                   Int       @id @default(autoincrement())
  novelId              Int
  title                String
  content              String    // 预言概述
  probability          Int       // 概率 0-100
  endingType           String    // good, bad, hidden, tragic
  keyFactors           String    // JSON: 关键因素
  involvedCharacterIds String    // JSON: 涉及角色ID
  basedOnPlotIds       String    // JSON: 基于哪些情节
  batchId              String    @default("legacy") // 批次ID，用于区分不同批次的预言
  isAdopted            Boolean   @default(false)  // 是否被采用
  createdAt            DateTime  @default(now())
  novel                Novel     @relation(fields: [novelId], references: [id])

  @@index([novelId])
  @@index([isAdopted])
  @@index([batchId])
}

// 情节干预记录模型
model PlotIntervention {
  id                Int       @id @default(autoincrement())
  plotId            Int
  interventionType  String    // manual, ai_assisted, branch_select
  originalContent   String    // 原始内容 JSON
  newContent        String    // 新内容 JSON
  reason            String?   // 干预原因
  createdAt         DateTime  @default(now())
  plot              Plot      @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([plotId])
  @@index([createdAt])
}

// ============================================
// 新增：小镇地图系统模型
// ============================================

// 统一大地图模型
model TownMap {
  id            Int      @id @default(autoincrement())
  novelId       Int      @unique
  
  // 地图基本信息
  name          String   @default("小镇")
  
  // 地图尺寸（格子数）
  width         Int      @default(40)
  height        Int      @default(30)
  
  // 每格像素大小
  tileSize      Int      @default(32)
  
  // 地图数据（JSON）
  // tiles[y][x] = { type: "ground"|"wall"|"water"|"grass"|"path"|"building", variant: 0-2 }
  tiles         String   @default("[]")
  
  // 可行走区域（JSON）
  // walkableMap[y][x] = 1 (可行走) | 0 (障碍)
  walkableMap   String   @default("[]")
  
  // 背景图（可选）
  backgroundUrl String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  novel         Novel    @relation(fields: [novelId], references: [id])
  regions       MapRegion[]
  
  @@index([novelId])
}

// 地图区域（对应现有 Scene 的位置概念）
model MapRegion {
  id            Int      @id @default(autoincrement())
  townMapId     Int
  
  // 区域名称（对应 Scene.name）
  name          String
  
  // 关联的场景 ID（可选，用于兼容现有数据）
  sceneId       Int?
  
  // 区域范围（格子坐标）
  startX        Int
  startY        Int
  endX          Int
  endY          Int
  
  // 区域类型（对应 Scene.type）
  type          String   @default("public")
  
  // 区域内可行走区域（可选覆盖）
  localWalkable String?  // JSON
  
  createdAt     DateTime @default(now())
  
  townMap       TownMap  @relation(fields: [townMapId], references: [id])
  
  @@index([townMapId])
  @@index([sceneId])
}

// 角色精确位置（扩展现有 Character，不修改原模型）
model CharacterPosition {
  id            Int      @id @default(autoincrement())
  characterId   Int      @unique
  
  // 精确位置（格子坐标，支持小数用于平滑移动）
  gridX         Float    @default(0)
  gridY         Float    @default(0)
  
  // 移动目标
  targetX       Float?
  targetY       Float?
  
  // 移动状态
  isMoving      Boolean  @default(false)
  moveSpeed     Float    @default(1.0)    // 格子/秒
  
  // 朝向
  direction     String   @default("down") // up|down|left|right
  
  // 当前所在区域
  currentRegionId Int?
  
  // 移动路径（JSON）
  currentPath   String   @default("[]")   // [{x, y}, ...]
  
  updatedAt     DateTime @updatedAt
  
  character     Character @relation(fields: [characterId], references: [id])
  
  @@index([characterId])
}

// 移动记录
model Movement {
  id            Int      @id @default(autoincrement())
  characterId   Int
  novelId       Int
  
  // 起点
  fromX         Float
  fromY         Float
  fromRegionId  Int?
  
  // 终点
  toX           Float
  toY           Float
  toRegionId    Int?
  
  // 路径
  path          String   @default("[]")   // JSON: [{x, y}, ...]
  
  // 时间
  startTime     DateTime @default(now())
  endTime       DateTime?
  
  // 状态
  status        String   @default("moving") // moving|arrived|interrupted
  
  // 原因（情节触发、自主移动等）
  reason        String?                    // plot:123, interaction, idle
  
  createdAt     DateTime @default(now())
  
  character     Character @relation(fields: [characterId], references: [id])
  novel         Novel     @relation(fields: [novelId], references: [id])
  
  @@index([characterId])
  @@index([novelId])
  @@index([status])
}
