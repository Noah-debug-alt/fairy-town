# Database - 使用 SQLite 本地数据库
DATABASE_URL="file:./prisma/dev.db"

# Server
PORT=3000

# LLM Model Configuration - 当前使用 Ollama 本地模型
LLM_PROVIDER="ollama"
LLM_MODEL="qwen3:4b"
PARSING_MODEL="qwen3:8b"
OLLAMA_BASE_URL="http://localhost:11434"

# Mock 模式说明：
# - 不需要安装任何大模型
# - 返回模拟的角色数据
# - 适合开发测试使用
# - 开发完成后可切换到真实模式：ollama、openai、deepseek 等

# 如需切换到真实大模型，请取消注释以下配置：

# 使用 Ollama 本地模型（免费）
# LLM_PROVIDER="ollama"
# LLM_MODEL="llama3"
# LLM_BASE_URL="http://localhost:11434/v1"

# 使用 OpenAI API（需要 API Key）
# LLM_PROVIDER="openai"
# LLM_MODEL="gpt-4o-mini"
# OPENAI_API_KEY="your-api-key"

# 使用 DeepSeek API（免费额度）
# LLM_PROVIDER="deepseek"
# LLM_MODEL="deepseek-chat"
# DEEPSEEK_API_KEY="your-api-key"

# ChromaDB（向量数据库）
CHROMADB_HOST="localhost"
CHROMADB_PORT=8000

# Image Generation Configuration - 图片生成配置
# 可选值: auto | diffusers | ollamadiffuser | siliconflow | sdwebui | dalle | placeholder
# auto: 自动选择最佳可用后端
# diffusers: 使用本地 diffusers 模型（免费！使用你已有的 Animagine XL 模型）
# ollamadiffuser: 使用 OllamaDiffuser 本地生图
# siliconflow: 使用 SiliconFlow 云端 API
# sdwebui: 使用 Stable Diffusion WebUI
# dalle: 使用 OpenAI DALL-E API
# placeholder: 使用 Canvas 占位图
IMAGE_GEN_PROVIDER="diffusers"

# 本地 diffusers 模型配置（使用你已有的 Animagine XL 模型！）
# 模型路径：D:\SD-WebUI\models\Stable-diffusion\AI-ModelScope\Animagine-XL-3___1
DIFFUSERS_MODEL_PATH="D:/SD-WebUI/models/Stable-diffusion/AI-ModelScope/Animagine-XL-3___1"
DIFFUSERS_SERVER_URL="http://localhost:7861"

# OllamaDiffuser 配置
OLLAMADIFFUSER_URL="http://localhost:8000"
OLLAMADIFFUSER_MODEL="flux.1-schnell"

# Stable Diffusion WebUI 配置
SD_WEBUI_URL="http://localhost:7860"

# SiliconFlow 配置
SILICONFLOW_API_KEY="your-siliconflow-api-key"
SILICONFLOW_MODEL="black-forest-labs/FLUX.1-schnell"

# DALL-E 配置
DALLE_MODEL="dall-e-3"
