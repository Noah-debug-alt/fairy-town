# Database - 使用 SQLite 本地数据库
DATABASE_URL="file:./prisma/dev.db"

# Server
PORT=3000

# OpenAI API (可选，如果使用在线API)
OPENAI_API_KEY="your-openai-api-key"

# LLM Model Configuration
# Provider: openai | claude | deepseek | moonshot | ollama
LLM_PROVIDER="ollama"
LLM_MODEL="llama3"

# Ollama 本地服务地址
LLM_BASE_URL="http://localhost:11434/v1"

# DeepSeek API (可选，如果使用 deepseek provider)
# DEEPSEEK_API_KEY="your-deepseek-api-key"

# Moonshot API (可选，如果使用 moonshot provider)
# MOONSHOT_API_KEY="your-moonshot-api-key"

# Claude API (可选，如果使用 claude provider)
# ANTHROPIC_API_KEY="your-anthropic-api-key"

# ChromaDB
CHROMADB_HOST="localhost"
CHROMADB_PORT=8000

# Image Generation - 图片生成配置
# Provider: auto | ollamadiffuser | siliconflow | sdwebui | dalle | placeholder
# auto: 自动选择最佳可用后端（推荐）
IMAGE_GEN_PROVIDER="auto"
# OllamaDiffuser（本地免费生图）：pip install "ollamadiffuser[full]"
OLLAMADIFFUSER_URL="http://localhost:8000"
OLLAMADIFFUSER_MODEL="flux.1-schnell"
# SD_WEBUI_URL="http://localhost:7860"
# SILICONFLOW_API_KEY="your-siliconflow-api-key"
# SILICONFLOW_MODEL="black-forest-labs/FLUX.1-schnell"
# DALLE_MODEL="dall-e-3"
